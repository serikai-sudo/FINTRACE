# --- FINTRACE artifacts ---
# Trajectories are never committed. The 20 episodes under data/ ARE committed (regenerate with
# `make data`): the jury must get them in a plain clone. Caches above (__pycache__, *.pyc) still
# apply inside data/.
trajectories/*.jsonl
!trajectories/rule_based_dev_10000.jsonl
data/.staging_*
!data/train/
!data/dev/
!data/**/*.json
!data/**/*.jsonl
!data/**/*.csv
!data/**/*.sha256
!data/**/*.txt
!data/manifest.json

# Keep directory placeholders
!.gitkeep
