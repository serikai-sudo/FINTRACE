{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fintrace:schema:trajectory:1.0.0",
  "title": "FINTRACE trajectory step (one line of a trajectories/*.jsonl file)",
  "description": "A single step record. Each line of a trajectory JSONL file is a self-contained JSON object conforming to this schema: the action the agent sent (optional `thought` included), the observation the environment returned, and the step's reward and end flags. The action is recorded as sent; on a successful step (`observation.ok`) it is a well-formed tool call (`$defs/ValidAction`), on a rejected step it may be any object. Nothing from the hidden episode (ground truth, injections, generator inputs, scoring diagnostics) is ever part of a line.",
  "type": "object",
  "additionalProperties": false,
  "required": ["episode_id", "step", "action", "observation", "reward", "terminated", "truncated"],
  "properties": {
    "episode_id": {"type": "string", "pattern": "^ep_[0-9a-f]{10,16}$"},
    "step": {"type": "integer", "minimum": 1, "maximum": 100},
    "action": {"type": "object"},
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "tool", "result", "error", "steps_used", "steps_remaining"],
      "properties": {
        "ok": {"type": "boolean"},
        "tool": {
          "type": "string",
          "enum": ["list_records", "get_record", "get_document", "calculator", "submit"]
        },
        "result": {"type": ["object", "null"]},
        "error": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["code"],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_ACTION",
                "INVALID_TABLE",
                "NOT_FOUND",
                "INVALID_CURSOR",
                "CALC_ERROR",
                "EPISODE_OVER",
                "INVALID_SUBMISSION"
              ]
            }
          }
        },
        "steps_used": {"type": "integer", "minimum": 0, "maximum": 100},
        "steps_remaining": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "reward": {"type": "number", "minimum": -1.0, "maximum": 1.0},
    "terminated": {"type": "boolean"},
    "truncated": {"type": "boolean"}
  },
  "if": {"properties": {"observation": {"properties": {"ok": {"const": true}}}}},
  "then": {"properties": {"action": {"$ref": "#/$defs/ValidAction"}}},
  "$defs": {
    "ValidAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "args"],
      "properties": {
        "tool": {
          "type": "string",
          "enum": ["list_records", "get_record", "get_document", "calculator", "submit"]
        },
        "args": {"type": "object"},
        "thought": {"type": ["string", "null"], "maxLength": 500}
      }
    }
  }
}
