{
  "$defs": {
    "InvoiceAllocation": {
      "additionalProperties": false,
      "description": "Portion of a payment allocated to one invoice.",
      "properties": {
        "allocated_minor": {
          "minimum": 0,
          "type": "integer"
        },
        "invoice_id": {
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_\\-:.]+$",
          "type": "string"
        }
      },
      "required": [
        "invoice_id",
        "allocated_minor"
      ],
      "title": "InvoiceAllocation",
      "type": "object"
    }
  },
  "$id": "urn:fintrace:schema:payment:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Payment document with its invoice allocations.",
  "properties": {
    "amount_minor": {
      "minimum": 0,
      "type": "integer"
    },
    "currency": {
      "pattern": "^[A-Z]{3}$",
      "type": "string"
    },
    "doc_id": {
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_\\-:.]+$",
      "type": "string"
    },
    "invoice_refs": {
      "items": {
        "$ref": "#/$defs/InvoiceAllocation"
      },
      "type": "array"
    },
    "payment_id": {
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_\\-:.]+$",
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    }
  },
  "required": [
    "doc_id",
    "payment_id",
    "timestamp",
    "currency",
    "amount_minor",
    "invoice_refs"
  ],
  "title": "Payment",
  "type": "object"
}
